{
  "manifest_version": 3,
  "name": "scrader",
  "version": "0.4.0",
  "description": "scrader (spider + scraper) — 把浏览器操作/网页抓取能力通过本地 MCP 桥暴露给任意 AI Agent，可选 Jev 快速决策",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": { "default_popup": "popup.html", "default_title": "scrader" },
  "permissions": ["tabs", "scripting", "storage", "alarms", "debugger"],
  "host_permissions": ["<all_urls>"]
}
